import { db } from "./firebase.js";

import {
  ref,
  set,
  get,
  child
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";


window.showPassword = function(){

let pass = document.getElementById("password");

if(pass.type === "password"){
    pass.type = "text";
}else{
    pass.type = "password";
}

}



window.registerUser = async function(){

let name = document.getElementById("name").value.trim();
let mobile = document.getElementById("mobile").value.trim();
let email = document.getElementById("email").value.trim();
let sponsor = document.getElementById("sponsor").value.trim();
let state = document.getElementById("state").value.trim();
let city = document.getElementById("city").value.trim();
let password = document.getElementById("password").value.trim();
let terms = document.getElementById("terms").checked;


if(!terms){

alert("Please accept Terms & Conditions");
return;

}


if(!name || !mobile || !email || !password){

alert("Please fill all required fields");
return;

}


try{


// Check Existing Users

let snapshot = await get(ref(db,"users"));


if(snapshot.exists()){

let users = snapshot.val();


for(let id in users){

if(users[id].mobile === mobile){

alert("Mobile number already registered");
return;

}


if(users[id].email === email){

alert("Email already registered");
return;

}

}

}


// Generate GWI ID

let gwiID = "GWI" + Math.floor(10000 + Math.random()*90000);


// Save User

await set(ref(db,"users/"+gwiID),{


gwiid:gwiID,

name:name,

mobile:mobile,

email:email,

sponsor:sponsor,

state:state,

city:city,

password:password,


status:"Inactive",

rank:"Starter",

level:0,


todayIncome:0,

totalIncome:0,

levelBonus:0,


joinDate:new Date().toLocaleDateString()


});


alert(
"Registration Successful\nYour GWI ID: "+gwiID
);


// Redirect Login

window.location.href="login.html";


}

catch(error){

alert(error.message);

}

}
